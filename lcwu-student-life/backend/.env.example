# Copy this file to .env and load it with your server or a tool such
# as vlucas/phpdotenv, or set these as real environment variables.
# The defaults in config/database.php match a typical local setup.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lcwu_student_life
DB_USER=studentlife
DB_PASS=change_me

# The frontend origin allowed to call this API. Use * only for local
# development, set the real deployed frontend URL in production.
CORS_ORIGIN=*
